{
  "$meta": {
    "tier": "Tier 2 semantic \u2014 dark override",
    "resolves": "[data-theme=dark]"
  },
  "bg": {
    "primary": "var(--primitive-gray-900)",
    "surface": "var(--primitive-gray-800)",
    "surface-glass": "rgba(28, 29, 36, 0.38)",
    "surface-glass-active": "rgba(36, 38, 48, 0.44)",
    "surface-elevated": "var(--primitive-gray-800)",
    "interactive": "var(--primitive-gray-700)",
    "interactive-hover": "var(--primitive-gray-800)",
    "interactive-active": "var(--primitive-gray-550)"
  },
  "border": {
    "thin": "rgba(255, 255, 255, 0.06)",
    "medium": "rgba(255, 255, 255, 0.12)",
    "thick": "rgba(255, 255, 255, 0.2)",
    "accent": "var(--primitive-gray-white)"
  },
  "text": {
    "primary": "var(--primitive-gray-white)",
    "secondary": "var(--primitive-gray-100)",
    "muted": "var(--primitive-gray-200)",
    "dim": "var(--primitive-gray-300)",
    "accent": "var(--primitive-gray-white)"
  },
  "accent": {
    "brand": "var(--signal)",
    "success": "var(--primitive-green-300)",
    "warning": "var(--primitive-orange-400)",
    "error": "var(--primitive-red-400)"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "lg": "0 12px 28px rgba(0, 0, 0, 0.5)"
  },
  "achievement": {
    "card-bg": "var(--primitive-gray-800)",
    "overlay-bg": "rgba(0, 0, 0, 0.7)"
  },
  "focus": {
    "ring": "0 0 0 2px var(--primitive-sapphire-ui-400)",
    "ring-offset": "0 0 0 4px rgba(33,138,234,0.15)"
  },
  "borderWidth": {
    "hairline": "var(--primitive-border-width-hairline)",
    "thin": "var(--primitive-border-width-thin)"
  },
  "role": {
    "action": "var(--signal)",
    "action-soft": "var(--primitive-sapphire-ui-400)",
    "action-ink": "var(--primitive-gray-white)",
    "measure": "var(--primitive-amethyst-400)",
    "measure-soft": "var(--primitive-amethyst-200)",
    "measure-strong": "var(--primitive-amethyst-500)",
    "score": "var(--primitive-red-beryl-400)",
    "warn": "var(--primitive-citrine-700)",
    "mark": "var(--primitive-amethyst-500)"
  }
}

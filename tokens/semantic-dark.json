{
  "$meta": {
    "tier": "Tier 2 semantic \u2014 dark override",
    "resolves": "[data-theme=dark]"
  },
  "bg": {
    "primary": "var(--primitive-gray-900)",
    "surface": "var(--primitive-gray-800)",
    "surface-glass": "rgba(28, 29, 36, 0.38)",
    "surface-glass-active": "rgba(36, 38, 48, 0.44)",
    "surface-elevated": "var(--primitive-gray-800)",
    "interactive": "var(--primitive-gray-700)",
    "interactive-hover": "var(--primitive-gray-800)",
    "interactive-active": "var(--primitive-gray-550)"
  },
  "border": {
    "subtle": "rgba(255, 255, 255, 0.06)",
    "default": "rgba(255, 255, 255, 0.12)",
    "strong": "rgba(255, 255, 255, 0.2)",
    "accent": "var(--primitive-gray-white)"
  },
  "text": {
    "primary": "var(--primitive-gray-white)",
    "secondary": "var(--primitive-gray-100)",
    "muted": "var(--primitive-gray-200)",
    "dim": "var(--primitive-gray-300)",
    "emphasis": "var(--primitive-gray-white)"
  },
  "accent": {
    "brand": "var(--signal)",
    "success": "var(--role-success)",
    "danger": "var(--role-danger)",
    "warning": "var(--role-warning)"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "lg": "0 12px 28px rgba(0, 0, 0, 0.5)",
    "mark": "0 1px 3px rgba(0, 0, 0, 0.45)"
  },
  "achievement": {
    "card": "var(--primitive-gray-800)",
    "scrim": "rgba(0, 0, 0, 0.7)"
  },
  "focus": {
    "ring": "0 0 0 2px var(--primitive-sapphire-ui-400)",
    "ring-offset": "0 0 0 4px rgba(33,138,234,0.15)"
  },
  "stroke": {
    "hairline": "var(--primitive-border-width-hairline)",
    "medium": "var(--primitive-border-width-medium)"
  },
  "role": {
    "action": "var(--signal)",
    "action-soft": "var(--primitive-sapphire-ui-300)",
    "action-strong": "var(--primitive-sapphire-ui-600)",
    "action-ink": "var(--primitive-gray-white)",
    "measure": "var(--primitive-amethyst-400)",
    "measure-soft": "var(--primitive-amethyst-200)",
    "measure-strong": "var(--primitive-amethyst-500)",
    "measure-ink": "var(--primitive-gray-white)",
    "score": "var(--primitive-red-beryl-400)",
    "score-soft": "var(--primitive-red-beryl-200)",
    "score-strong": "var(--primitive-red-beryl-500)",
    "score-ink": "var(--primitive-gray-white)",
    "streak": "var(--primitive-citrine-400)",
    "streak-soft": "var(--primitive-citrine-200)",
    "streak-strong": "var(--primitive-citrine-500)",
    "streak-ink": "var(--primitive-ink)",
    "success": "var(--primitive-green-300)",
    "success-soft": "var(--primitive-green-100)",
    "success-strong": "var(--primitive-green-400)",
    "success-ink": "var(--primitive-ink)",
    "danger": "var(--primitive-red-500)",
    "danger-soft": "var(--primitive-red-300)",
    "danger-strong": "var(--primitive-red-600)",
    "danger-ink": "var(--primitive-gray-white)",
    "warning": "var(--primitive-orange-400)",
    "warning-soft": "var(--primitive-orange-200)",
    "warning-strong": "var(--primitive-orange-500)",
    "warning-ink": "var(--primitive-ink)"
  },
  "type": {
    "title": "var(--font-size-3xl)",
    "card": "var(--font-size-xl)",
    "body": "var(--font-size-md)",
    "meta": "var(--font-size-sm)",
    "micro": "var(--font-size-xs)"
  }
}

{
  "$meta": {
    "tier": "Tier 2 semantic \u2014 light default",
    "resolves": ":root, [data-theme=light]"
  },
  "bg": {
    "primary": "var(--primitive-neutral-light-200)",
    "surface": "var(--primitive-gray-white)",
    "surface-glass": "rgba(255, 255, 255, 0.38)",
    "surface-glass-active": "rgba(255, 255, 255, 0.46)",
    "surface-elevated": "var(--primitive-gray-white)",
    "interactive": "var(--primitive-gray-100)",
    "interactive-hover": "var(--primitive-gray-50)",
    "interactive-active": "var(--primitive-gray-200)"
  },
  "border": {
    "thin": "var(--primitive-gray-100)",
    "medium": "rgba(15, 16, 21, 0.08)",
    "thick": "rgba(15, 16, 21, 0.15)",
    "accent": "var(--primitive-gray-900)"
  },
  "text": {
    "primary": "var(--primitive-ink)",
    "secondary": "var(--primitive-gray-700)",
    "muted": "var(--primitive-gray-300)",
    "dim": "var(--primitive-dim)",
    "accent": "var(--primitive-gray-900)"
  },
  "accent": {
    "brand": "var(--signal)",
    "success": "var(--primitive-green-300)",
    "warning": "var(--primitive-orange-400)",
    "error": "var(--primitive-red-400)"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(15, 16, 21, 0.04)",
    "md": "0 4px 12px rgba(15, 16, 21, 0.06)",
    "lg": "0 12px 28px rgba(15, 16, 21, 0.08)",
    "mark": "0 1px 3px rgba(15, 16, 21, 0.45)"
  },
  "achievement": {
    "card-bg": "var(--primitive-gray-white)",
    "overlay-bg": "rgba(15, 16, 21, 0.3)"
  },
  "focus": {
    "ring": "0 0 0 2px var(--primitive-sapphire-ui-400)",
    "ring-offset": "0 0 0 4px rgba(33,138,234,0.15)"
  },
  "borderWidth": {
    "hairline": "var(--primitive-border-width-hairline)",
    "thin": "var(--primitive-border-width-thin)"
  },
  "role": {
    "action": "var(--signal)",
    "action-soft": "var(--primitive-sapphire-ui-400)",
    "action-ink": "var(--primitive-gray-white)",
    "measure": "var(--primitive-amethyst-400)",
    "measure-soft": "var(--primitive-amethyst-200)",
    "measure-strong": "var(--primitive-amethyst-500)",
    "score": "var(--primitive-red-beryl-400)",
    "warn": "var(--primitive-citrine-700)",
    "mark": "var(--primitive-amethyst-500)"
  },
  "type": {
    "title": "var(--font-size-3xl)",
    "card": "var(--font-size-xl)",
    "body": "var(--font-size-md)",
    "meta": "var(--font-size-sm)",
    "micro": "var(--font-size-xs)"
  }
}
